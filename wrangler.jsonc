{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clowder-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  // Static site files. Only /api/* reaches the Worker; everything else is
  // served directly from ./public.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "onirudesign.com", "custom_domain": true },
    { "pattern": "www.onirudesign.com", "custom_domain": true }
  ],
  // Saved quote requests. Schema lives in ./migrations.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clowder-quotes",
      "database_id": "a82be422-7a4c-4e7a-a6df-d5cfc284fdab",
      "migrations_dir": "migrations"
    }
  ],
  // Per-visitor burst limit for the quote form: 3 requests per 60 seconds.
  "ratelimits": [
    {
      "name": "QUOTE_BURST",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ]
}
