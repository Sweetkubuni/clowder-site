{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clowder-site",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public"
  },
  "routes": [
    { "pattern": "onirudesign.com", "custom_domain": true },
    { "pattern": "www.onirudesign.com", "custom_domain": true }
  ]
}
